<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Discord_Bot</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="DSharpPlus" Version="4.5.3" />
	<PackageReference Include="DSharpPlus.CommandsNext" Version="4.5.3" />
	<PackageReference Include="DSharpPlus.Interactivity" Version="4.5.3" />
	<PackageReference Include="DSharpPlus.SlashCommands" Version="4.5.3" />
    <PackageReference Include="DSharpPlus.VoiceNext" Version="4.5.3" />
    <PackageReference Include="Google.Apis" Version="1.70.0" />
    <PackageReference Include="Google.Apis.Core" Version="1.70.0" />
    <PackageReference Include="Google.Apis.CustomSearchAPI.v1" Version="1.68.0.3520" />
    <PackageReference Include="Lavalink4NET.DSharpPlus" Version="4.2.2" />
    <PackageReference Include="Lavalink4NET.InactivityTracking" Version="4.2.2" />
    <PackageReference Include="Lavalink4NET.Lyrics" Version="4.2.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.22" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="OpenAI" Version="1.11.0" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.22" />
    <PackageReference Include="System.Net.Http.Json" Version="9.0.22" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Config\fish_data.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Folder Include=".github\upgrades\scenarios\dotnet-version-upgrade\tasks\01-upgrade-discord-bot\" />
    <Folder Include=".github\upgrades\scenarios\dotnet-version-upgrade\tasks\02-solution-validation\" />
  </ItemGroup>

</Project>
